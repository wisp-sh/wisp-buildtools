@@ -145,8 +146,12 @@
         From: from::expand_deriving_from,
     }
 
-    let client = rustc_proc_macro::bridge::client::Client::expand1(rustc_proc_macro::quote);
-    register(sym::quote, SyntaxExtensionKind::Bang(Arc::new(BangProcMacro { client })));
+    let client = rustc_proc_macro::bridge::client::Client::expand1(rustc_proc_macro::quote)
