 pub(crate) fn init(sess: &Session) {
     unsafe {
-        // Before we touch LLVM, make sure that multithreading is enabled.
-        if !llvm::LLVMIsMultithreaded().is_true() {
+        // Native codegen requires threads. The WASI backend runs serially with
+        // the SDK's thread-free LLVM, so it does not require this capability.
+        if !cfg!(target_os = "wasi") && !llvm::LLVMIsMultithreaded().is_true() {
             bug!("LLVM compiled without support for threads");
         }
         INIT.call_once(|| {
@@ -127,7 +128,9 @@
             }
         }
 
-        if wants_wasm_eh(sess) {
+        // LLVM 24 removed this option; UseWasmEH already selects the target
+        // machine's exception model in LLVMRustCreateTargetMachine.
+        if wants_wasm_eh(sess) && get_version().0 < 24 {
             add("-wasm-enable-eh", false);
         }
 
diff --git a/compiler/rustc_codegen_ssa/src/back/link.rs b/compiler/rustc_codegen_ssa/src/back/link.rs
--- a/compiler/rustc_codegen_ssa/src/back/link.rs
+++ b/compiler/rustc_codegen_ssa/src/back/link.rs
@@ -1281,6 +1281,21 @@
 
     // Invoke the system linker
     info!("{cmd:?}");
+    #[cfg(target_os = "wasi")]
+    {
+        if !matches!(flavor, LinkerFlavor::WasmLld(Cc::No)) {
+            sess.dcx().fatal("the WASI compiler supports only its embedded WebAssembly linker");
+        }
+        unsafe extern "C" {
+            fn RustRunLld(argc: std::ffi::c_int, argv: *const *const std::ffi::c_char) -> std::ffi::c_int;
+        }
+        let command = cmd.command();
+        let mut args = command.get_args().map(|arg| std::ffi::CString::new(arg.as_encoded_bytes()).unwrap()).collect::<Vec<_>>();
+        args.insert(0, std::ffi::CString::new("wasm-ld").unwrap());
+        let argv = args.iter().map(|arg| arg.as_ptr()).collect::<Vec<_>>();
+        let code = unsafe { RustRunLld(argv.len() as std::ffi::c_int, argv.as_ptr()) };
+        std::process::exit(code);
+    }
     let unknown_arg_regex =
         Regex::new(r"(unknown|unrecognized) (command line )?(option|argument)").unwrap();
