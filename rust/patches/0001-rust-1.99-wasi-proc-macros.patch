 fn main() {
     let target_os = env::var("CARGO_CFG_TARGET_OS");
     let target_env = env::var("CARGO_CFG_TARGET_ENV");
+    if target_os.as_deref() == Ok("wasi") && target_env.as_deref() == Ok("p3") {
+        // The compiler links through clang rather than the bundled component
+        // linker, so explicitly retain std's canonical ABI allocator export.
+        println!("cargo:rustc-link-arg-bin=rustc-main=-Wl,--export=cabi_realloc");
+    }
     if Ok("windows") == target_os.as_deref() && Ok("msvc") == target_env.as_deref() {
         set_windows_exe_options();
     } else {
