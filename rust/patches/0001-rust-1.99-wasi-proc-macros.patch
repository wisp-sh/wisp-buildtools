+#[cfg(target_os = "wasi")]
+fn is_writeable(p: &Path) -> bool {
+    // WASI stat data has no Unix write-permission bits. Probe the actual
+    // capability without creating or truncating the file instead.
+    match std::fs::OpenOptions::new().write(true).open(p) {
+        Ok(_) => true,
+        Err(error) => error.kind() != std::io::ErrorKind::PermissionDenied,
+    }
+}
