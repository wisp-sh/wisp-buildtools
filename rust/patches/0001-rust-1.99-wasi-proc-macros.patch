@@ -0,0 +1,248 @@
+//! Interpret a matching-version proc_macro bridge in a separate Wasm memory.
+//!
+//! The guest's declarations are queried through scalar exports. Its only host
+//! import is the existing byte-buffer RPC dispatcher, including token/span
+//! handles. This first target has no filesystem, environment or process API.
+use std::io::Write;
+use std::path::Path;
+
+use rustc_proc_macro::bridge::server::{DynClient, client_error};
+use rustc_proc_macro::bridge::{BridgeConfig, Buffer, Closure};
+use rustc_data_structures::sync::IntoDynSyncSend;
+use wasmi::{AsContextMut, Caller, Engine, Instance, Linker, Memory, Module, Store, TypedFunc};
+
+const MAX_BUFFER: usize = 64 * 1024 * 1024;
+const FUEL: u64 = 500_000_000;
+
+struct Context<'a> {
+    dispatch: Option<Closure<'a>>,
+    client: Option<ClientRefs>,
+    limits: wasmi::StoreLimits,
+}
+
+#[derive(Clone)]
+struct ClientRefs {
+    memory: Memory,
+    replace: TypedFunc<(u32, u32), ()>,
+    pointer: TypedFunc<u32, u32>,
+    length: TypedFunc<u32, u32>,
+    drop_buffer: TypedFunc<u32, ()>,
+}
+
+impl ClientRefs {
+    fn new(instance: &Instance, store: &Store<Context<'_>>) -> Result<Self, wasmi::Error> {
+        Ok(Self {
+            memory: instance
+                .get_memory(store, "memory")
+                .ok_or_else(|| wasmi::Error::new("macro has no exported memory"))?,
+            replace: instance.get_typed_func(store, "__rustc_proc_macro_buffer_replace")?,
+            pointer: instance.get_typed_func(store, "__rustc_proc_macro_buffer_ptr")?,
+            length: instance.get_typed_func(store, "__rustc_proc_macro_buffer_len")?,
+            drop_buffer: instance.get_typed_func(store, "__rustc_proc_macro_drop_buffer")?,
+        })
+    }
+
+    fn read(&self, mut store: impl AsContextMut, buffer: u32) -> Result<Vec<u8>, wasmi::Error> {
+        let length = self.length.call(&mut store, buffer)? as usize;
+        if length > MAX_BUFFER {
+            return Err(wasmi::Error::new("macro RPC buffer exceeds 64 MiB"));
+        }
+        let pointer = self.pointer.call(&mut store, buffer)? as usize;
+        let mut bytes = vec![0; length];
+        self.memory.read(&store, pointer, &mut bytes)?;
+        Ok(bytes)
+    }
+
+    fn write(
+        &self,
+        mut store: impl AsContextMut,
+        buffer: u32,
+        bytes: &[u8],
+    ) -> Result<(), wasmi::Error> {
+        if bytes.len() > MAX_BUFFER {
+            return Err(wasmi::Error::new("macro RPC buffer exceeds 64 MiB"));
+        }
+        self.replace.call(&mut store, (buffer, bytes.len() as u32))?;
+        let pointer = self.pointer.call(&mut store, buffer)?;
+        self.memory.write(&mut store, pointer as usize, bytes)?;
+        Ok(())
+    }
+
+    fn read_string(
+        &self,
+        mut store: impl AsContextMut,
+        buffer: u32,
+    ) -> Result<String, wasmi::Error> {
+        let bytes = self.read(&mut store, buffer)?;
+        self.drop_buffer.call(&mut store, buffer)?;
+        String::from_utf8(bytes).map_err(|_| wasmi::Error::new("macro declaration is not UTF-8"))
+    }
+}
+
+fn dispatch(
+    mut caller: Caller<'_, Context<'_>>,
+    input: u32,
+    output: u32,
+) -> Result<(), wasmi::Error> {
+    let client = caller
+        .data()
+        .client
+        .clone()
+        .ok_or_else(|| wasmi::Error::new("macro RPC called before initialization"))?;
+    let bytes = client.read(&mut caller, input)?;
+    let response = caller
+        .data_mut()
+        .dispatch
+        .as_mut()
+        .ok_or_else(|| wasmi::Error::new("macro RPC called during declaration loading"))?
+        .call(bytes.into());
+    client.write(&mut caller, output, &response)
+}
+
+fn instantiate<'a>(
+    engine: &Engine,
+    module: &Module,
+    dispatch_fn: Option<Closure<'a>>,
+) -> Result<(Store<Context<'a>>, Instance, ClientRefs), wasmi::Error> {
+    let limits = wasmi::StoreLimitsBuilder::new().memory_size(256 * 1024 * 1024).build();
+    let mut store = Store::new(engine, Context { dispatch: dispatch_fn, client: None, limits });
+    store.limiter(|context| &mut context.limits);
+    store.set_fuel(FUEL)?;
+    let mut linker = Linker::new(engine);
+    linker.func_wrap("env", "__rustc_proc_macro_dispatch", dispatch)?;
+    let instance = linker.instantiate(&mut store, module)?.start(&mut store)?;
+    let client = ClientRefs::new(&instance, &store)?;
+    store.data_mut().client = Some(client.clone());
+    Ok((store, instance, client))
+}
+
+fn declarations(
+    instance: &Instance,
+    store: &Store<Context<'_>>,
+    symbol: &str,
+) -> Result<u32, wasmi::Error> {
+    instance
+        .get_global(store, symbol)
+        .and_then(|global| global.get(store).i32())
+        .map(|value| value as u32)
+        .ok_or_else(|| wasmi::Error::new(format!("missing proc-macro declarations: {symbol}")))
+}
+
+fn expand(
+    engine: &Engine,
+    module: &Module,
+    symbol: &str,
+    index: u32,
+    config: BridgeConfig<'_>,
+) -> Result<Buffer, wasmi::Error> {
+    let (mut store, instance, client) = instantiate(engine, module, Some(config.dispatch))?;
+    let declarations = declarations(&instance, &store, symbol)?;
+    let alloc = instance.get_typed_func::<u32, u32>(&store, "__rustc_proc_macro_alloc_buffer")?;
+    let call = instance
+        .get_typed_func::<(u32, u32, u32, u32), u32>(&store, "__rustc_proc_macro_call_client")?;
+    let input = alloc.call(&mut store, 0)?;
+    client.write(&mut store, input, &config.input)?;
+    let output =
+        call.call(&mut store, (input, declarations, index, config.force_show_panics as u32))?;
+    let response = client.read(&mut store, output)?;
+    client.drop_buffer.call(&mut store, output)?;
+    Ok(response.into())
+}
+
+#[derive(Clone)]
+struct MacroIdentity {
+    module: String,
+    index: u32,
+    name: String,
+    kind: &'static str,
+}
+
+fn json_string(value: &str) -> String {
+    let mut result = String::from("\"");
+    for character in value.chars() {
+        match character {
+            '"' => result.push_str("\\\""),
+            '\\' => result.push_str("\\\\"),
+            character if character <= '\u{1f}' => {
+                result.push_str(&format!("\\u{:04x}", character as u32))
+            }
+            character => result.push(character),
+        }
+    }
+    result.push('"');
+    result
+}
+
+fn trace(event: &str, status: &str, identity: &MacroIdentity) -> Result<(), String> {
+    let Some(path) = std::env::var_os("WISP_WASM_PROC_MACRO_LOG") else { return Ok(()) };
+    let line = format!(
+        "{{\"schemaVersion\":1,\"event\":{},\"status\":{},\"runtime\":\"wasmi\",\"module\":{},\"index\":{},\"name\":{},\"kind\":{},\"macroTarget\":\"wasm32-unknown-unknown\"}}\n",
+        json_string(event),
+        json_string(status),
+        json_string(&identity.module),
+        identity.index,
+        json_string(&identity.name),
+        json_string(identity.kind),
+    );
+    std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .and_then(|mut file| file.write_all(line.as_bytes()))
+        .map_err(|error| format!("cannot write Wasm macro execution trace: {error}"))
+}
+
+fn dynamic_client(
+    engine: Engine,
+    module: Module,
+    symbol: String,
+    identity: MacroIdentity,
+) -> DynClient {
+    DynClient { run: std::sync::Arc::new(move |config| {
+        if let Err(error) = trace("invoke", "started", &identity) {
+            return client_error(error);
+        }
+        match expand(&engine, &module, &symbol, identity.index, config) {
+            Ok(output) => match trace("invoke", "succeeded", &identity) {
+                Ok(()) => output,
+                Err(error) => client_error(error),
+            },
+            Err(error) => {
+                let _ = trace("invoke", "failed", &identity);
+                client_error(format!("Wasm procedural macro failed: {error}"))
+            }
+        }
+    }) }
+}
+
+
+pub(crate) fn load(
+    path: &Path, symbol: &str, kinds: &[crate::rmeta::ProcMacroKind],
+) -> Result<Vec<IntoDynSyncSend<DynClient>>, String> {
+    let mut config = wasmi::Config::default();
+    config.consume_fuel(true);
+    let engine = Engine::new(&config);
+    let bytes = std::fs::read(path).map_err(|error| error.to_string())?;
+    let module = Module::new(&engine, &bytes).map_err(|error| error.to_string())?;
+    let (mut store, instance, _) = instantiate(&engine, &module, None).map_err(|error| error.to_string())?;
+    let declarations = declarations(&instance, &store, symbol).map_err(|error| error.to_string())?;
+    let length = instance.get_typed_func::<u32, u32>(&store, "__rustc_proc_macro_decls_len")
+        .and_then(|function| function.call(&mut store, declarations)).map_err(|error| error.to_string())?;
+    if length as usize != kinds.len() || length > 65_536 {
+        return Err("proc-macro declaration count differs from compiler metadata".into());
+    }
+    // WASI realpath may fail for an absolute preopen path that was read above.
+    // Match the crate locator's fallback to the original path in that case.
+    let path = rustc_fs_util::try_canonicalize(path).unwrap_or_else(|_| path.to_path_buf());
+    kinds.iter().enumerate().map(|(index, kind)| {
+        use crate::rmeta::ProcMacroKind;
+        let (name, kind) = match kind {
+            ProcMacroKind::Bang { name } => (name, "function"),
+            ProcMacroKind::Attr { name } => (name, "attribute"),
+            ProcMacroKind::CustomDerive { trait_name, .. } => (trait_name, "derive"),
+        };
+        let identity = MacroIdentity { module: path.to_string_lossy().into_owned(), index: index as u32, name: name.clone(), kind };
+        trace("load", "succeeded", &identity)?;
+        Ok(IntoDynSyncSend(dynamic_client(engine.clone(), module.clone(), symbol.into(), identity)))
+    }).collect()
+}
