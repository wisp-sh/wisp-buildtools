+// These scalar exports form the same-version bridge between independent Wasm
+// memories. Rust enums, references and function pointers stay inside the guest.
+#[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+#[allow(unsafe_code)]
+mod wasm {
+    use super::*;
+
+    #[no_mangle]
+    pub extern "C" fn __rustc_proc_macro_alloc_buffer(len: usize) -> *mut Buffer {
+        Box::into_raw(Box::new(Buffer::from(vec![0; len])))
+    }
+    #[no_mangle]
+    pub unsafe extern "C" fn __rustc_proc_macro_buffer_replace(buffer: *mut Buffer, len: usize) {
+        *buffer = Buffer::from(vec![0; len]);
+    }
+    #[no_mangle]
+    pub unsafe extern "C" fn __rustc_proc_macro_buffer_ptr(buffer: *mut Buffer) -> *mut u8 {
+        (*buffer).as_mut_ptr()
+    }
+    #[no_mangle]
+    pub unsafe extern "C" fn __rustc_proc_macro_buffer_len(buffer: *const Buffer) -> usize {
+        (&*buffer).len()
+    }
+    #[no_mangle]
+    pub unsafe extern "C" fn __rustc_proc_macro_drop_buffer(buffer: *mut Buffer) {
+        drop(Box::from_raw(buffer));
+    }
+    #[no_mangle]
+    pub unsafe extern "C" fn __rustc_proc_macro_decls_len(decls: *const &[ProcMacro]) -> usize {
+        (*decls).len()
+    }
+    #[no_mangle]
+    pub unsafe extern "C" fn __rustc_proc_macro_decl_kind(
+        decls: *const &[ProcMacro],
+        index: usize,
+    ) -> u32 {
+        match &(*decls)[index] {
+            ProcMacro::Bang { .. } => 0,
+            ProcMacro::Attr { .. } => 1,
+            ProcMacro::CustomDerive { .. } => 2,
+        }
+    }
+    #[no_mangle]
+    pub unsafe extern "C" fn __rustc_proc_macro_decl_name(
+        decls: *const &[ProcMacro],
+        index: usize,
+    ) -> *mut Buffer {
+        Box::into_raw(Box::new(Buffer::from((*decls)[index].name().as_bytes().to_vec())))
+    }
+    #[no_mangle]
+    pub unsafe extern "C" fn __rustc_proc_macro_decl_helpers(
+        decls: *const &[ProcMacro],
+        index: usize,
+    ) -> *mut Buffer {
+        let text = match &(*decls)[index] {
+            ProcMacro::CustomDerive { attributes, .. } => attributes.join("\0"),
+            _ => String::new(),
+        };
+        Box::into_raw(Box::new(Buffer::from(text.into_bytes())))
+    }
+    #[no_mangle]
+    pub unsafe extern "C" fn __rustc_proc_macro_call_client(
+        input: *mut Buffer,
+        decls: *const &[ProcMacro],
+        index: usize,
+        force_show_panics: bool,
+    ) -> *mut Buffer {
+        #[link(wasm_import_module = "env")]
+        extern "C" {
+            fn __rustc_proc_macro_dispatch(input: *const Buffer, output: *mut Buffer);
+        }
+        let input = Box::from_raw(input).take();
+        let mut dispatch = |input: Buffer| {
+            let mut output = Buffer::new();
+            unsafe { __rustc_proc_macro_dispatch(&input, &mut output) };
+            output
+        };
+        let config = BridgeConfig {
+            input,
+            dispatch: (&mut dispatch).into(),
+            force_show_panics,
+            _marker: PhantomData,
+        };
+        let output = match &(*decls)[index] {
+            ProcMacro::Bang { client, .. } | ProcMacro::CustomDerive { client, .. } => {
+                (client.run)(config)
+            }
+            ProcMacro::Attr { client, .. } => (client.run)(config),
+        };
+        Box::into_raw(Box::new(output))
+    }
+}
