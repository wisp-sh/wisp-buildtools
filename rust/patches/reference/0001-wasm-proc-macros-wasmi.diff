+            let (output_buffer,) = call_client.call(&mut store, (input_buffer, func_ptr)).unwrap();
+
+            let output_buffer_data = client_refs.read(&mut store, output_buffer).unwrap();
+
+            output_buffer_data.into()
+        }),
+    }
+}
