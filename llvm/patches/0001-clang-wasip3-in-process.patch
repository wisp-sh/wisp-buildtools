--- /dev/null
+++ b/clang/tools/driver/clang_p3_main.cpp
@@ -0,0 +1,44 @@
+// Minimal WASIp3 compiler host: integrated Clang cc1, then in-process wasm LLD.
+#include "lld/Common/Driver.h"
+#include "llvm/Support/InitLLVM.h"
+#include "llvm/Support/Driver.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <string>
+#include <vector>
+
+int clang_main(int argc, char **argv, const llvm::ToolContext &);
+LLD_HAS_DRIVER(wasm)
+
+int main(int argc, char **argv) {
+  llvm::InitLLVM Init(argc, argv);
+  llvm::errs() << "clang-p3: ready\n";
+  if (argc != 4 || std::string(argv[2]) != "-o") {
+    llvm::errs() << "usage: clang-p3 /work/input.cpp -o /work/output.wasm\n";
+    return 2;
+  }
+
+  const std::string object = std::string(argv[3]) + ".o";
+  std::vector<const char *> clangArgs = {
+      "clang", "--target=wasm32-unknown-unknown", "-x", "c++",
+      "-ffreestanding", "-nostdinc", "-nostdinc++", "-fintegrated-cc1",
+      "-c", argv[1], "-o", object.c_str()};
+  std::vector<char *> mutableArgs;
+  for (const char *arg : clangArgs)
+    mutableArgs.push_back(const_cast<char *>(arg));
+
+  llvm::ToolContext context(argv[0], nullptr, false);
+  const int compileResult =
+      clang_main(static_cast<int>(mutableArgs.size()), mutableArgs.data(), context);
+  if (compileResult)
+    return compileResult;
+  llvm::errs() << "clang-p3: codegen-complete\n";
+
+  const char *linkArgs[] = {"wasm-ld", "--no-entry", "--export=add",
+                            object.c_str(), "-o", argv[3]};
+  const lld::DriverDef wasmDriver = {lld::Wasm, &lld::wasm::link};
+  const lld::Result linkResult =
+      lld::lldMain(linkArgs, llvm::outs(), llvm::errs(), {wasmDriver});
+  llvm::errs() << "clang-p3: link-complete\n";
+  return linkResult.retCode;
+}
