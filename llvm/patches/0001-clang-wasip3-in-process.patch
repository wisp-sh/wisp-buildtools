+
+ProcessInfo::ProcessInfo() : Pid(0), ReturnCode(0) {}
+
+ErrorOr<std::string> sys::findProgramByName(StringRef,
+                                            ArrayRef<StringRef>) {
+  return make_error_code(errc::function_not_supported);
+}
+
+static bool Execute(ProcessInfo &, StringRef, ArrayRef<StringRef>,
+                    std::optional<ArrayRef<StringRef>>,
+                    ArrayRef<std::optional<StringRef>>, unsigned,
+                    std::string *ErrMsg, BitVector *, bool) {
+  if (ErrMsg)
+    *ErrMsg = "subprocess execution is unavailable in clang-p3";
+  return false;
+}
+
+ProcessInfo sys::Wait(const ProcessInfo &, std::optional<unsigned>,
+                      std::string *ErrMsg,
+                      std::optional<ProcessStatistics> *, bool) {
+  if (ErrMsg)
+    *ErrMsg = "subprocess wait is unavailable in clang-p3";
+  ProcessInfo Result;
+  Result.ReturnCode = -1;
+  return Result;
+}
+
+std::error_code sys::ChangeStdinMode(fs::OpenFlags) { return {}; }
+std::error_code sys::ChangeStdoutMode(fs::OpenFlags) { return {}; }
+std::error_code sys::ChangeStdinToBinary() { return {}; }
+std::error_code sys::ChangeStdoutToBinary() { return {}; }
+
+std::error_code sys::writeFileWithEncoding(StringRef FileName,
+                                           StringRef Contents,
+                                           WindowsEncodingMethod) {
+  std::error_code EC;
+  raw_fd_ostream OS(FileName, EC, fs::OF_None);
+  if (EC)
+    return EC;
+  OS << Contents;
+  if (OS.has_error())
+    return make_error_code(errc::io_error);
+  return {};
+}
+
+bool sys::commandLineFitsWithinSystemLimits(StringRef,
+                                            ArrayRef<StringRef>) {
+  return true;
+}
