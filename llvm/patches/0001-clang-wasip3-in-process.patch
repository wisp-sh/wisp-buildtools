+// WASI has linear memory and no executable mappings. LLVM's JIT is disabled.
+#include <cstdlib>
+#include <system_error>
+
+namespace llvm::sys {
+
+MemoryBlock Memory::allocateMappedMemory(size_t NumBytes,
+                                         const MemoryBlock *const,
+                                         unsigned Flags,
+                                         std::error_code &EC) {
+  if (Flags & MF_EXEC) {
+    EC = std::make_error_code(std::errc::function_not_supported);
+    return {};
+  }
+  if (!NumBytes) {
+    EC = {};
+    return {};
+  }
+  constexpr size_t PageSize = 65536;
+  if (NumBytes > SIZE_MAX - (PageSize - 1)) {
+    EC = std::make_error_code(std::errc::not_enough_memory);
+    return {};
+  }
+  const size_t Rounded = (NumBytes + PageSize - 1) & ~(PageSize - 1);
+  void *Address = std::aligned_alloc(PageSize, Rounded);
+  if (!Address) {
+    EC = std::make_error_code(std::errc::not_enough_memory);
+    return {};
+  }
+  EC = {};
+  return {Address, Rounded};
+}
+
+std::error_code Memory::releaseMappedMemory(MemoryBlock &Block) {
+  std::free(Block.base());
+  Block = {};
+  return {};
+}
+
+std::error_code Memory::protectMappedMemory(const MemoryBlock &, unsigned Flags) {
+  if (Flags & MF_EXEC)
+    return std::make_error_code(std::errc::function_not_supported);
+  return {};
+}
+
+void Memory::InvalidateInstructionCache(const void *, size_t) {}
+
+} // namespace llvm::sys
