+// Select maximally specific interface declarations, including legitimate
+// abstract-to-default overrides reached through multiple inheritance paths.
+static bool extends_interface(const classdesc *child, const classdesc *parent) {
+  if (child == parent) return true;
+  for (int i = 0; i < arrlen(child->itables.interfaces); i++)
+    if (child->itables.interfaces[i] == parent) return true;
+  return false;
+}
+
+static bool interface_method(const cp_method *method) {
+  return method && !(method->access_flags & (ACCESS_PRIVATE | ACCESS_STATIC));
+}
+
+static itable_method_t select_interface_method(classdesc *cd, cp_method *signature) {
+  if (!(cd->access_flags & ACCESS_INTERFACE)) {
+    cp_method *method = method_lookup(cd, signature->name, signature->unparsed_descriptor, true, false);
+    if (interface_method(method)) return make(method);
+  }
+  cp_method *abstract = nullptr, *concrete = nullptr;
+  bool ambiguous = false;
+  for (int i = 0; i < arrlen(cd->itables.interfaces); i++) {
+    classdesc *owner = cd->itables.interfaces[i];
+    cp_method *method = method_lookup(owner, signature->name, signature->unparsed_descriptor, false, false);
+    if (!interface_method(method)) continue;
+    bool dominated = false;
+    for (int j = 0; j < arrlen(cd->itables.interfaces); j++) {
+      classdesc *other = cd->itables.interfaces[j];
+      if (owner == other || !extends_interface(other, owner)) continue;
+      cp_method *overriding = method_lookup(other, signature->name, signature->unparsed_descriptor, false, false);
+      if (interface_method(overriding)) { dominated = true; break; }
+    }
+    if (dominated) continue;
+    if (method->access_flags & ACCESS_ABSTRACT) abstract = method;
+    else {
+      if (concrete && concrete != method) ambiguous = true;
+      concrete = method;
+    }
+  }
+  if (concrete) return ambiguous ? mark_ambiguous(make(concrete)) : make(concrete);
+  return make(abstract ? abstract : signature);
+}
+
+static void normalize_interface_methods(classdesc *cd) {
+  string_hash_table resolved = make_hash_table(nullptr, 0.75, 16);
+  for (int i = 0; i < arrlen(cd->itables.entries); i++) {
+    itable *entry = cd->itables.entries + i;
+    for (int j = 0; j < arrlen(entry->methods); j++) {
+      cp_method *signature = get_unambiguous_method(entry->methods[j]);
+      INIT_STACK_STRING(scratch, 2048);
+      slice key = identify(&scratch, signature);
+      itable_method_t selected = (itable_method_t)hash_table_lookup(&resolved, key.chars, key.len);
+      if (!selected) {
+        selected = select_interface_method(cd, signature);
+        (void)hash_table_insert(&resolved, key.chars, key.len, (void *)selected);
+      }
+      entry->methods[j] = selected;
+    }
+  }
+  free_hash_table(resolved);
+}
