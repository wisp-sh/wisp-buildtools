    "rust": {
      "directory": "rust",
      "description": "Rust 1.99.1 compiler Component with Wasm build scripts and procedural macros",
      "version": "1.99.1",
      "dependencies": [
        "llvm"
      ],
      "runtimeDependencies": [],
      "bootstrapRequirements": [
        "Linux x86_64",
        "Python 3.12+",
        "native C and C++ compilers",
        "CMake",
        "Ninja",
        "patch",
        "WASI SDK 34 at rust/downloads/wasi-sdk-34.0-x86_64-linux",
        "native Cargo for locked metadata and vendoring",
        "several GiB RAM and tens of GiB disk for Rust and LLVM",
        "pinned Binaryen for compiler Component optimization"
      ],
      "build": [
        {
          "action": "rust-source",
          "description": "Prepare checksum-pinned Rust sources and apply the WASIp3/LLVM 24 compiler patch"
        },
        {
          "argv": [
            "{python}",
            "-I",
            "{root}/rust/scripts/build-compiler.py",
            "--build",
            "--jobs",
            "{jobs}",
            "--macro-patch",
            "{root}/rust/patches/0001-rust-1.99-wasi-proc-macros.patch",
            "--wasm-opt",
            "{wasm_opt}",
            "--wasm-opt-library-dir",
            "{wasm_opt_lib}"
          ]
        },
        {
          "action": "rust-package",
          "description": "Package the successfully source-built compiler and matching sysroots"
        }
      ],
      "test": [
        {
          "argv": [
            "{python}",
            "-m",
            "unittest",
            "discover",
            "-s",
            "{root}/rust/tests",
            "-v"
          ]
        },
        {
          "action": "rust-acceptance",
          "description": "Run scalar, std, base64, build-script, derive and Serde application acceptance in Wasm"
        }
      ],
      "artifacts": [
        "rust/dist/compiler/toolchain.json",
        "rust/dist/compiler/build/bootstrap/rustc.wasm",
        "rust/dist/compiler/build/bootstrap/SHA256SUMS.json",
        "rust/dist/compiler/scripts/runner.py"
      ],
      "package": {
        "include": [
          "rust/README.md",
          "rust/dist/compiler"
        ],
        "optional": []
      }
    },
