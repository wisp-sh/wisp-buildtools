{
  "schema": 1,
  "description": "Compiler-package builds. Application compilation remains in toolchains.py and each language adapter.",
  "tools": {
    "clang": {
      "directory": "clang",
      "description": "C and C++ compiler Component",
      "version": "llvm-24-d297af3",
      "source": {
        "repository": "https://github.com/llvm/llvm-project",
        "revision": "d297af3b3d7a086d64f1477cfa682a16fcfa3260"
      },
      "sourceInputs": [
        "clang/build-clang-wasi.sh",
        "clang/src/clang_wasm_main.cpp",
        "clang/target_sdk.py",
        "llvm/licenses/sdk/receipts.json",
        "clang/verify_wasi_runtime.py",
        "clang/examples/wasi-runtime.cpp",
        "clang/test_target_sdk.py",
        "clang/patches/0001-clang-wasip3-in-process.patch",
        "clang/patches/0002-driverless-clang-wasm.patch",
        "llvm/toolchain.toml",
        "llvm/scripts/shared.py",
        "nim/src/c_backend.cpp",
        "llvm/shared.py"
      ],
      "dependencies": [],
      "runtimeDependencies": [
        "llvm"
      ],
      "bootstrapRequirements": [
        "Linux x86_64",
        "Python 3.12+",
        "CMake 3.24+",
        "GCC and G++",
        "curl",
        "patch",
        "tar",
        "unzip",
        "several GiB RAM and disk for LLVM"
      ],
      "build": [
        {
          "action": "clang-build",
          "description": "Build pinned C/C++ compiler sources, validate WASI 0.3 API and compile add(20,22) = 42"
        }
      ],
      "test": [
        {
          "argv": [
            "{python}",
            "-m",
            "unittest",
            "discover",
            "-s",
            "clang",
            "-p",
            "test_target_sdk.py"
          ]
        },
        {
          "argv": [
            "bash",
            "{root}/clang/verify-clang-wasm.sh"
          ]
        },
        {
          "argv": [
            "{python}",
            "{root}/clang/verify_wasi_runtime.py"
          ]
        }
      ],
      "artifacts": [
        "clang/.toolchains/build-p3/bin/clang-wasm.component",
        "clang/include/stddef.h",
        "clang/wasi-sdk/manifest.json"
      ],
      "package": {
        "include": [
          "clang/README.md",
          "clang/examples",
          "clang/src",
          "clang/.toolchains/build-p3/bin/clang-wasm.component",
          "clang/.toolchains/llvm-project/LICENSE.TXT"
        ],
        "optional": [
          "clang/LICENSE"
        ]
      }
    },
    "go": {
      "directory": "go",
      "description": "Go compiler, assembler, linker and standard library",
      "version": "1.27.2",
      "dependencies": [],
      "runtimeDependencies": [],
      "bootstrapRequirements": [
        "Python 3.12+",
        "official Go 1.27.2 distribution at WISP_GO_HOST_ROOT",
