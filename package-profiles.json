{
  "schema": 1,
  "platform": "wasm32-wasi",
  "packageVersion": "0.1.0",
  "tools": {
    "clang": {
      "include": [
        "clang/.toolchains/build-p3/bin/clang-wasm.component",
        "clang/.toolchains/llvm-project/LICENSE.TXT",
        "clang/DRIVERLESS.md",
        "clang/include",
        "clang/wasi-sdk",
        "clang/target_sdk.py",
        "llvm/toolchain.toml"
      ],
      "optional": [],
      "exclude": [],
      "entrypoints": [
        {
          "name": "clang",
          "path": "clang/.toolchains/build-p3/bin/clang-wasm.component",
          "format": "wasm-component"
        }
      ],
      "requirements": [
        {
          "name": "Wisp Wasmtime host",
          "kind": "runtime-host",
          "version": "50.0.0",
          "included": false,
          "note": "Wisp-owned execution host with WASI Preview 3 and external Component core-module imports. Select it with WISP_WASMTIME. The engine is not part of this compiler package."
        }
      ],
      "roles": [
        {
          "pattern": "clang/wasi-sdk/licenses/*",
          "role": "licenses"
        },
        {
          "pattern": "clang/wasi-sdk/share/wasi-sysroot/include/*",
          "role": "headers"
        },
        {
          "pattern": "clang/wasi-sdk/lib/clang/23/include/*",
          "role": "headers"
        },
        {
          "pattern": "clang/wasi-sdk/*.a",
          "role": "runtime"
        },
        {
          "pattern": "clang/wasi-sdk/*.o",
          "role": "runtime"
        },
        {
          "pattern": "clang/include/*",
          "role": "headers"
        },
        {
          "pattern": "*/licenses/*",
          "role": "licenses"
        },
        {
          "pattern": "*/LICENSE*",
          "role": "licenses"
        },
        {
          "pattern": "*/COPYRIGHT*",
          "role": "licenses"
        },
        {
          "pattern": "*/README.md",
          "role": "documentation"
        },
        {
          "pattern": "*/DRIVERLESS.md",
          "role": "documentation"
        },
        {
          "pattern": "*/manifest.json",
          "role": "metadata"
        },
        {
          "pattern": "*/manifest.toml",
          "role": "metadata"
        },
        {
          "pattern": "*/toolchain.json",
          "role": "metadata"
        },
        {
          "pattern": "*/toolchain.lock.json",
          "role": "metadata"
        },
        {
          "pattern": "*/SHA256SUMS*",
          "role": "metadata"
        },
        {
          "pattern": "clang/*.component",
          "role": "compiler"
        },
        {
          "pattern": "clang/.toolchains/build-p3/bin/*",
          "role": "compiler"
        }
      ]
    },
